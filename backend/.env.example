AI_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Retrieval
MAX_CONTEXT_CHUNKS=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# Cost Optimization & Context Window limits
MAX_USER_TOKENS=50000
MODEL_CONTEXT_WINDOW=8192


# Storage
SQLITE_PATH=data/documents.db

# Supabase Storage Backup (optional for free-tier cloud persistence like Render)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# SMTP Email Settings (optional for real OTP delivery, falls back to console printing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
