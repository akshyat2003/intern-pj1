AI_PROVIDER=groq

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM (optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Retrieval settings
MAX_CONTEXT_CHUNKS=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cost & Context Window
MAX_USER_TOKENS=50000
MODEL_CONTEXT_WINDOW=8192

# Auth
AUTH_SECRET=change-this-to-a-random-secret

# Storage
SQLITE_PATH=data/documents.db

# Supabase (optional - for cloud persistence on free-tier hosts like Render)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# MSG91 SMS OTP (get from https://msg91.com)
MSG91_AUTHKEY=your-msg91-authkey
MSG91_TEMPLATE_ID=your-msg91-template-id
