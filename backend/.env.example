AI_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Retrieval
MAX_CONTEXT_CHUNKS=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# Storage
# Leave DATABASE_URL empty for local SQLite. Set it to a hosted Postgres URL in production.
DATABASE_URL=
SQLITE_PATH=data/documents.db

# Auth
AUTH_SECRET=change-this-to-a-long-random-secret
AUTH_TOKEN_MINUTES=10080
OTP_EXPIRY_MINUTES=10

# MSG91 SMS OTP. Leave empty to fallback to local Dev OTP.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=


